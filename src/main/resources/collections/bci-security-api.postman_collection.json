		{
			"name": "Sign Up - Valid User",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Postman Test Script: Extract \"token\" from response and set it as environment variable \"token\"",
							"",
							"pm.test(\"Extract and set token\", function () {",
							"    var response = pm.response.json();",
							"    if (response.token) {",
							"        pm.environment.set(\"token\", response.token);",
							"        console.log(\"Token set in environment variable: \" + response.token);",
							"    } else {",
							"        console.error(\"Token not found in response!\");",
							"    }",
							"});"
